# Copiar a .env.local y completar. Nunca commitear .env.local (ya está en
# .gitignore).

# Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Dashboard -> Project Settings -> API -> service_role key.
# Bypassa RLS: solo se usa en Server Actions, para operaciones de admin
# como crear usuarios (ver src/lib/supabase/admin.ts). No exponer nunca
# al cliente (por eso no lleva el prefijo NEXT_PUBLIC_).
SUPABASE_SERVICE_ROLE_KEY=

# Número de WhatsApp del botón flotante, formato internacional sin "+"
# ni espacios. Ejemplo Argentina: 549 + código de área sin 0 + número
# sin 15. Ej: 5491122334455
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Opcional, solo para desarrollo local: navegar sin pasar por /login,
# con un perfil simulado. Valores: admin | vendedor | cliente. Se
# ignora siempre fuera de NODE_ENV=development (ver
# src/lib/dev-sin-login.ts). Dejar vacío o sin definir para probar el
# login real.
DEV_SIN_LOGIN=
